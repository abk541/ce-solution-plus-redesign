{
  "$description": "CE Solution Plus design tokens (DTCG). Three tiers: primitive → semantic → component. Compiled to CSS custom properties by build.mjs. Primitives are never referenced by components directly.",
  "primitive": {
    "color": {
      "navy": {
        "950": { "$type": "color", "$value": "#060e1b", "$description": "Deepest navy, hero vignette" },
        "900": { "$type": "color", "$value": "#0a1628", "$description": "Base dark surface" },
        "800": { "$type": "color", "$value": "#102240", "$description": "Raised dark surface" },
        "700": { "$type": "color", "$value": "#1b3a6b", "$description": "Federal blue: links on light, ribbon" }
      },
      "slate": {
        "600": { "$type": "color", "$value": "#4b5768", "$description": "Muted text on light (7.34:1 on white)" },
        "500": { "$type": "color", "$value": "#5d6878", "$description": "Secondary muted text on light (5.65:1)" },
        "400": { "$type": "color", "$value": "#9aa8bd", "$description": "Muted text on navy (7.52:1); input border on light (UI, 3.5:1 for #7d8a9e)" },
        "300": { "$type": "color", "$value": "#7d8a9e", "$description": "Input borders on light (3.5:1 on white)" },
        "200": { "$type": "color", "$value": "#c9d2de", "$description": "Lead text on navy (11.9:1)" },
        "100": { "$type": "color", "$value": "#e7ebf1", "$description": "Light raised surface" },
        "50":  { "$type": "color", "$value": "#f4f6f9", "$description": "Light page background" }
      },
      "red": {
        "700": { "$type": "color", "$value": "#8f1435", "$description": "Pressed state of red on light" },
        "600": { "$type": "color", "$value": "#b31942", "$description": "Old Glory red: accent and error on light (6.19:1 on paper)" },
        "400": { "$type": "color", "$value": "#e04a5f", "$description": "Red on navy-900 (4.59:1). On navy-800 large text only (4.01:1)" }
      },
      "green": { "700": { "$type": "color", "$value": "#1e6b45", "$description": "Success text (6.47:1 on white)" } },
      "white": { "$type": "color", "$value": "#ffffff" }
    },
    "font": {
      "display": { "$type": "fontFamily", "$value": ["Barlow Condensed", "Arial Narrow", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Headlines. Drawn from American highway / federal signage." },
      "text": { "$type": "fontFamily", "$value": ["Barlow", "Helvetica Neue", "Arial", "sans-serif"], "$description": "Body and UI. Same superfamily; 2 families total." }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "24px" },
      "6": { "$type": "dimension", "$value": "32px" },
      "7": { "$type": "dimension", "$value": "48px" },
      "8": { "$type": "dimension", "$value": "64px" },
      "9": { "$type": "dimension", "$value": "96px" },
      "10": { "$type": "dimension", "$value": "128px" }
    },
    "duration": {
      "instant": { "$type": "duration", "$value": "100ms" },
      "fast": { "$type": "duration", "$value": "200ms", "$description": "Hover, focus, press, icon swaps" },
      "base": { "$type": "duration", "$value": "300ms", "$description": "Menus, panels, tabs" },
      "moderate": { "$type": "duration", "$value": "500ms", "$description": "Section reveals" },
      "slow": { "$type": "duration", "$value": "800ms", "$description": "Counters, hero scene fade-in. UI maximum." },
      "ambient": { "$type": "duration", "$value": "40s", "$description": "Background loops only" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.2, 0.7, 0.2, 1], "$description": "Entrances: arrive fast, settle. Default." },
      "in": { "$type": "cubicBezier", "$value": [0.5, 0, 0.75, 0], "$description": "Exits" },
      "inOut": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1], "$description": "In-place state changes, scroll-linked" },
      "linear": { "$type": "cubicBezier", "$value": [0, 0, 1, 1], "$description": "Ambient loops, progress" }
    }
  },
  "semantic": {
    "light": {
      "bg": { "$type": "color", "$value": "{primitive.color.slate.50}" },
      "surface": { "$type": "color", "$value": "{primitive.color.white}" },
      "surface-raised": { "$type": "color", "$value": "{primitive.color.slate.100}" },
      "text": { "$type": "color", "$value": "{primitive.color.navy.900}" },
      "text-muted": { "$type": "color", "$value": "{primitive.color.slate.600}" },
      "border": { "$type": "color", "$value": "rgba(10, 22, 40, 0.14)" },
      "border-strong": { "$type": "color", "$value": "{primitive.color.navy.900}" },
      "border-input": { "$type": "color", "$value": "{primitive.color.slate.300}" },
      "accent": { "$type": "color", "$value": "{primitive.color.red.600}" },
      "link": { "$type": "color", "$value": "{primitive.color.navy.700}" },
      "focus": { "$type": "color", "$value": "{primitive.color.red.600}" },
      "error": { "$type": "color", "$value": "{primitive.color.red.600}" },
      "success": { "$type": "color", "$value": "{primitive.color.green.700}" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "{primitive.color.navy.900}" },
      "surface": { "$type": "color", "$value": "{primitive.color.navy.800}" },
      "surface-raised": { "$type": "color", "$value": "{primitive.color.navy.800}" },
      "text": { "$type": "color", "$value": "{primitive.color.white}" },
      "text-muted": { "$type": "color", "$value": "{primitive.color.slate.400}" },
      "border": { "$type": "color", "$value": "rgba(255, 255, 255, 0.14)" },
      "border-strong": { "$type": "color", "$value": "{primitive.color.white}" },
      "border-input": { "$type": "color", "$value": "{primitive.color.slate.400}" },
      "accent": { "$type": "color", "$value": "{primitive.color.red.400}" },
      "link": { "$type": "color", "$value": "{primitive.color.white}" },
      "focus": { "$type": "color", "$value": "{primitive.color.red.400}" },
      "error": { "$type": "color", "$value": "{primitive.color.red.400}" },
      "success": { "$type": "color", "$value": "#6fd3a0" }
    },
    "radius": {
      "none": { "$type": "dimension", "$value": "0px", "$description": "Default: institutional, square" },
      "sm": { "$type": "dimension", "$value": "2px", "$description": "Inputs, tags" },
      "round": { "$type": "dimension", "$value": "999px", "$description": "Status dots only" }
    },
    "shadow": {
      "1": { "$type": "shadow", "$value": "0 1px 2px rgba(10, 22, 40, 0.08), 0 8px 24px -16px rgba(10, 22, 40, 0.35)" },
      "2": { "$type": "shadow", "$value": "0 2px 4px rgba(10, 22, 40, 0.08), 0 24px 48px -28px rgba(10, 22, 40, 0.5)" }
    }
  },
  "component": {
    "button": {
      "height": { "$type": "dimension", "$value": "52px" },
      "height-sm": { "$type": "dimension", "$value": "44px" },
      "padding-x": { "$type": "dimension", "$value": "{primitive.space.5}" }
    },
    "strip": { "height": { "$type": "dimension", "$value": "36px" } },
    "header": { "height": { "$type": "dimension", "$value": "72px" } },
    "ribbon": { "$type": "gradient", "$value": "linear-gradient(90deg, #b31942 0 16%, #fff 16% 24%, #1b3a6b 24% 76%, #fff 76% 84%, #b31942 84%)", "$description": "Medal-ribbon marker; small elements only" },
    "band": { "$type": "gradient", "$value": "linear-gradient(180deg, #b31942 0 40%, #fff 40% 60%, #1b3a6b 60%)", "$description": "Full-width tricolour edge" }
  }
}
